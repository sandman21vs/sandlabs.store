# Opcional. Deixe ADMIN_PASSWORD vazio para usar o setup inicial em /admin/setup.
SECRET_KEY=change-me-to-a-random-string

# Segredo mestre da criptografia de PII (nome, endereco, email dos clientes).
# Use uma frase-semente BIP39 (12-24 palavras) — e o backup mais simples.
# NUNCA versione este valor nem o guarde no banco. Se vazio, cai no
# SHIPPING_DATA_KEY (legado) e, na ausencia deste, num default inseguro de dev.
MASTER_MNEMONIC=
MASTER_MNEMONIC_PASSPHRASE=
# Legado: chave anterior de criptografia de envio. Mantida para descriptografar
# dados antigos; prefira MASTER_MNEMONIC para novos deploys.
SHIPPING_DATA_KEY=
DATABASE_PATH=/app/data/sandlabs.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Defaults de bootstrap. Depois de salvos em /admin/settings, os valores do banco
# passam a ter prioridade sobre o .env durante o runtime.
COINOS_API_KEY=
COINOS_WEBHOOK_SECRET=
COINOS_ENABLED=0
